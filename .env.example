# Base Deployment URL
ORIGIN="http://localhost:5173"

# Neon Postgres Database (Drizzle ORM)
DATABASE_URL="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth (Session Secret & Social OAuth)
# Generate a 32-character key: openssl rand -hex 32
BETTER_AUTH_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Polar Payments Configuration (Merchant of Record)
POLAR_ENVIRONMENT="sandbox" # "sandbox" or "production"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# Public Product IDs (Standard and Pro Tiers)
PUBLIC_POLAR_STANDARD_PRODUCT_ID=""
PUBLIC_POLAR_PRO_PRODUCT_ID=""

# Upstash Redis (Cache, SSE & Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Upstash QStash (Background Job Queue & Signature Verification)
# QSTASH_URL=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Resend (Transactional Email Delivery)
RESEND_API_KEY=""
EMAIL_FROM="SuperSvelte <notifications@yourdomain.com>"

# UploadThing (Default Zero-Config Direct File Uploads)
UPLOADTHING_TOKEN=""

# Cloudflare R2 / AWS S3 Object Storage ($0 Egress Direct Presigned Uploads)
# S3_BUCKET="my-bucket"
# S3_REGION="auto" # 'auto' for Cloudflare R2, 'us-east-1' for AWS
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_DOMAIN="https://pub-yourdomain.r2.dev"
