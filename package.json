{
	"name": "supersvelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:check": "pnpm check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"validate": "pnpm lint && pnpm check && pnpm test",
		"precommit": "pnpm format && pnpm lint && pnpm check && pnpm test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset": "drizzle-kit drop && drizzle-kit push && pnpm db:seed",
		"db:drop": "drizzle-kit drop",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"make:resource": "tsx scripts/scaffold-resource.ts",
		"manage": "tsx scripts/manage.ts",
		"package:zip": "tsx scripts/manage.ts package"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.6.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.47.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.1",
		"@vitest/coverage-v8": "^5.0.1",
		"auth": "^1.7.4",
		"dotenv": "^18.0.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-seed": "^0.3.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1131.0",
		"@aws-sdk/s3-request-presigner": "^3.1131.0",
		"@formkit/auto-animate": "^0.10.0",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.3",
		"@hono/zod-validator": "^0.9.1",
		"@neondatabase/serverless": "^1.1.0",
		"@polar-sh/sdk": "^0.49.0",
		"@uploadthing/svelte": "^7.3.3",
		"@upstash/qstash": "^2.11.3",
		"@upstash/ratelimit": "^2.1.0",
		"@upstash/redis": "^1.38.4",
		"better-auth": "^1.7.4",
		"better-svelte-email": "^2.3.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.7",
		"mode-watcher": "^1.1.0",
		"resend": "^6.28.0",
		"runed": "^0.37.1",
		"shiki": "^4.4.3",
		"super-sitemap": "^2.0.6",
		"svelte-meta-tags": "^5.0.2",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"uploadthing": "^7.7.4",
		"yaxa-svelte": "^1.11.0",
		"zod": "^4.6.5"
	}
}
