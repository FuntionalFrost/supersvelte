{
	"name": "supersvelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:check": "pnpm check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"validate": "pnpm lint && pnpm check && pnpm test",
		"precommit": "pnpm format && pnpm lint && pnpm check && pnpm test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset": "drizzle-kit drop && drizzle-kit push && pnpm db:seed",
		"db:drop": "drizzle-kit drop",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"make:resource": "tsx scripts/scaffold-resource.ts",
		"manage": "tsx scripts/manage.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-netlify": "^7.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "^5.0.3",
		"dotenv": "^18.0.5",
		"drizzle-kit": "^0.31.11",
		"drizzle-seed": "^0.3.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shiki": "^4.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@aws-sdk/s3-request-presigner": "^3.1156.0",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.3",
		"@hono/zod-validator": "^0.9.1",
		"@neondatabase/serverless": "^1.2.0",
		"@polar-sh/sdk": "^1.0.2",
		"@uploadthing/svelte": "^7.3.3",
		"@upstash/qstash": "^2.12.0",
		"@upstash/ratelimit": "^2.2.0",
		"@upstash/redis": "^1.40.0",
		"better-auth": "^1.7.7",
		"better-svelte-email": "^2.3.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.12",
		"resend": "^6.34.1",
		"tailwind-merge": "^3.7.0",
		"uploadthing": "^7.7.4",
		"yaxa-svelte": "^2.1.0",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
