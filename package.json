{
	"name": "supersvelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"make:resource": "tsx scripts/scaffold-resource.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.30.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"auth": "^1.6.26",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.5.2",
		"@hono/zod-validator": "^0.9.0",
		"@neondatabase/serverless": "^1.1.0",
		"@polar-sh/sdk": "^0.49.0",
		"@uploadthing/svelte": "^7.3.3",
		"@upstash/qstash": "^2.11.3",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.2",
		"better-auth": "^1.6.26",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"formsnap": "^2.0.1",
		"hono": "^4.13.1",
		"mode-watcher": "^1.1.0",
		"resend": "^6.18.1",
		"shiki": "^4.4.2",
		"super-sitemap": "^2.0.6",
		"svelte-meta-tags": "^5.0.2",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"uploadthing": "^7.7.4",
		"zod": "^4.4.3"
	}
